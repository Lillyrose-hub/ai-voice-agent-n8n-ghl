    {
      "parameters": {
        "jsCode": "const e = $('Extract Call Data').first().json;\nconst c = $('Upsert Contact').first().json;\nconst id = c.contact && c.contact.id;\nconst nm = ((e.firstName || '') + ' ' + (e.lastName || '')).trim() || 'Inbound caller';\nreturn [{ json: { op: 'createOpportunity', payload: { contactId: id, name: nm + ' - ' + (e.intent || 'inquiry'), stage: 'new' } } }];"
      },
