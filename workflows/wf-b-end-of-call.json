        "jsCode": "const c = $('Upsert Contact').first().json;\nconst id = c.contact && c.contact.id;\nreturn [{ json: { op: 'sendMessage', payload: { contactId: id, channel: 'sms', message: 'Thanks for calling! We logged your request and will follow up shortly.' } } }];"
      },
