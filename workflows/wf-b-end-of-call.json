      "typeVersion": 1.2,
      "position": [
        140,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $('Extract Call Data').first().json;\nconst c = $('Upsert Contact').first().json;\nconst id = c.contact && c.contact.id;\nconst body = 'Call summary: ' + (e.summary || '(none)') + '\\n\\nTranscript:\\n' + (e.transcript || '(none)');\nreturn [{ json: { op: 'addNote', payload: { contactId: id, body } } }];"
      },
      "id": "wfb_pn",
