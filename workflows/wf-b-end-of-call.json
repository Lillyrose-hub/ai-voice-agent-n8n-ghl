    {
      "parameters": {
        "jsCode": "const b = items[0].json.body || items[0].json || {};\nconst msg = b.message || {};\nif (msg.type && msg.type !== 'end-of-call-report') { return []; }\nconst sd = (msg.analysis && msg.analysis.structuredData) || {};\nconst phone = (msg.customer && msg.customer.number) || sd.phone || '';\nreturn [{ json: {\n  phone,\n  firstName: sd.firstName || '',\n  lastName: sd.lastName || '',\n  email: sd.email || '',\n  transcript: msg.transcript || '',\n  summary: msg.summary || '',\n  intent: sd.intent || ''\n} }];"
      },
      "id": "wfb_extract",
      "name": "Extract Call Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $('Extract Call Data').first().json;\nreturn [{ json: { op: 'upsertContact', payload: { firstName: e.firstName, lastName: e.lastName, phone: e.phone, email: e.email } } }];"
      },
      "id": "wfb_pu",
      "name": "Prep Upsert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
